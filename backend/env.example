# Copy to .env for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables.
# Never commit .env.

# Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# Public anon key: used only for Supabase Auth calls (sign up / log in / refresh).
SUPABASE_ANON_KEY=
# Service-role key: full database access. Server-side only. Never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of frontend origins allowed to call the API (CORS).
ALLOWED_ORIGINS=https://your-frontend-project.vercel.app

# Random secret (32+ chars) used to hash IPs for rate limiting, so raw IPs are never stored.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SECRET=

# AES-256 key that encrypts users' personal details (full name, role, city, LinkedIn) at rest.
# 64 hex chars. Generate like IP_HASH_SECRET above. Losing it makes stored names unreadable. Back it up.
PII_ENCRYPTION_KEY=

# AES-256 key (64 hex chars) that encrypts the session cookies. Changing it logs everyone out.
SESSION_COOKIE_KEY=

# Secret (32+ chars) for hashing email codes and signing the short-lived "email verified" token.
AUTH_TOKEN_SECRET=

# ---------- Email (OTP, security notices, notifications, and digests) ----------
# MAIL_DRIVER: smtp (Gmail in production) | console (prints emails in the terminal, local only)
MAIL_DRIVER=smtp
# Gmail plus-addresses all use the same inbox and App Password.
MAIL_FROM_EMAIL=ghosted.help+noreply@gmail.com
MAIL_FROM_NAME=Ghosted
MAIL_REPLY_TO_EMAIL=ghosted.help+support@gmail.com
MAIL_REPLY_TO_NAME=Ghosted Support

# --- SMTP via Gmail / Google Workspace ---
# 1. Turn on 2-Step Verification for the Google account.
# 2. Create an App Password at https://myaccount.google.com/apppasswords (16 characters).
# Limits: ~500 emails/day on free Gmail, ~2,000/day on Google Workspace.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# false = STARTTLS on 587 (recommended); true = implicit TLS on 465.
SMTP_SECURE=false
SMTP_USER=ghosted.help@gmail.com
SMTP_PASS="xxxx xxxx xxxx xxxx"

# Weekly digest: Vercel Cron calls /v1/cron/digest every Monday (see vercel.json) and sends this
# secret as a Bearer token. Set the same value in Vercel → Settings → Environment Variables.
CRON_SECRET=

# The website's address, used for every link (and the logo image) in emails. Required.
# The main app's assigned Vercel production URL.
FRONTEND_URL=https://your-frontend-project.vercel.app

# The admin panel (admin/ app). Admin endpoints answer only these origins; empty = admin API off.
# The separately deployed admin app's assigned Vercel production URL. See admin/README.md.
ADMIN_ORIGINS=https://your-admin-project.vercel.app
# Who the admins are: email:Name:role, comma-separated (role = owner, admin, moderator or viewer). No passwords:
# each admin sets their own from the panel with a code emailed to them.
ADMIN_EMAILS=you@example.com:Your Name:owner

# Goofy's daily brief goes to every admin who leaves "Daily brief" on in the panel's Settings.
# Optional: MODERATOR_EMAILS=a@x.com,b@y.com also copies it to people who aren't admins.

# Donations (the /feedback page) through Razorpay. Dashboard → Account & Settings → API Keys →
# Generate Key. Use test keys (rzp_test_…) locally and live keys (rzp_live_…) in production.
# The secret never leaves the server: the page only ever sees the key id.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional but recommended: Dashboard → Webhooks → Add → URL https://<api>/v1/donations/webhook,
# event "payment.captured", and a secret you choose (paste the same one here).
RAZORPAY_WEBHOOK_SECRET=


# Local dev port
PORT=8787

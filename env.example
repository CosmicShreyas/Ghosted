# Frontend. Public values only; never put secrets here (VITE_* vars are shipped to the browser).
# Leave VITE_API_URL empty to run the main interface on mock data. In the public Vercel project,
# use /api so requests use the same-origin rewrite in vercel.json and session cookies work.
# The separately deployed admin app does not use member cookies and may use the full backend URL.
VITE_API_URL=

# Admin app only. Set this in the admin Vercel project to the deployed public-app URL.
VITE_SITE_URL=https://ghostd.in

# Server only (not VITE_*, never reaches the browser): the same value as the API's SITE_RENDER_KEY,
# so pages rendered on the server for search engines aren't rate limited as one visitor.
SITE_RENDER_KEY=

# Frontend. Public values only; never put secrets here (VITE_* vars are shipped to the browser).
# Leave VITE_API_URL empty to run the main interface on mock data. For deployments,
# configure it in each Vercel project with the API endpoint appropriate to that app.
VITE_API_URL=

# Admin app only. Set this in the admin Vercel project to the deployed public-app URL.
VITE_SITE_URL=https://your-frontend-project.vercel.app
